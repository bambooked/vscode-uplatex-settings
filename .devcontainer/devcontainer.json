{
    "name": "LaTeX-Container",
    "dockerComposeFile": "docker-compose.yml",
    "service": "texlive-ja",
    "workspaceFolder": "/workdir",
    "customizations": {
        "vscode": {
            "extensions": [
                "james-yu.latex-workshop"
            ],
            "settings": {
                "files.exclude": {
                    "**/*.dvi": true,
                    "**/*.synctex.gz": true
                }
            }
        }
    },
    "remoteUser": "root"
}